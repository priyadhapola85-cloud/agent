# ------------------------------------------------------------------
# Fashion AI Studio — environment configuration
#
# HOW TO USE:
#   1. Copy this file and name the copy ".env.local" (same folder).
#   2. Fill in the values in .env.local (NOT in this file).
#   3. Restart `npm run dev` after any change.
#
# .env.local is ignored by Git, so your secrets never get committed.
# Never paste real keys into chat, issues, screenshots or this file.
# ------------------------------------------------------------------

# --- App login (required) ---------------------------------------
# The password you type on the login page. Use something long.
APP_PASSWORD=change-me-to-a-long-password
# Random secret used to sign the login cookie (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-characters

# --- FREE image + video generation (Hugging Face) ---------------
# Works with NO key at all (small shared daily allowance).
# Optional: a free token gives you more free GPU minutes per day.
# Create one at https://huggingface.co/settings/tokens  (type "Read", no payment).
HF_TOKEN=

# --- PAID image + video generation (fal.ai) — optional -----------
# Get a key at https://fal.ai/dashboard/keys  (needs account credit).
# Only needed if you choose a paid model.
FAL_KEY=

# --- Anthropic Claude (reference analysis + storyboard planning) -
# Get a key at https://platform.claude.com/settings/keys
# Without it, reference-image analysis is unavailable (you write the
# description yourself) and storyboards use the basic template planner.
ANTHROPIC_API_KEY=

# --- Optional: model overrides -----------------------------------
# Leave empty to use the defaults shown in Settings.
# Defaults are the FREE models. Paid examples:
# IMAGE_MODEL=fal-ai/nano-banana-pro/edit
# VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional: database ------------------------------------------
# Empty = built-in embedded PostgreSQL (PGlite) stored in ./data/pglite.
# Set a normal Postgres URL to use a real server instead, e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/fashion_ai
DATABASE_URL=

# --- Optional: where generated media is stored -------------------
# Defaults to ./storage (private — not publicly served).
# STORAGE_DIR=./storage
